{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "darkBackground": "#101820",
    "darkPanel": "#16222C",
    "darkElement": "#1D2E3A",
    "darkBorderSubtle": "#29404F",
    "darkBorder": "#3B596C",
    "darkBorderActive": "#6790A9",
    "darkText": "#DCEBFA",
    "darkMuted": "#91AABD",
    "darkPrimary": "#7EB4EE",
    "darkSecondary": "#F17A86",
    "darkAccent": "#68C6D8",
    "darkError": "#F17A86",
    "darkWarning": "#E1B66E",
    "darkSuccess": "#72C29A",
    "darkInfo": "#70B8EA",
    "lightBackground": "#FBFDFF",
    "lightPanel": "#F4F9FF",
    "lightElement": "#EAF4FF",
    "lightBorderSubtle": "#DCEAF6",
    "lightBorder": "#C8DFF0",
    "lightBorderActive": "#8FB6D6",
    "lightText": "#1B344A",
    "lightMuted": "#5D768C",
    "lightPrimary": "#3975B5",
    "lightSecondary": "#C83D4B",
    "lightAccent": "#247A98",
    "lightError": "#C83D4B",
    "lightWarning": "#846421",
    "lightSuccess": "#347A60",
    "lightInfo": "#3975B5"
  },
  "theme": {
    "primary": { "dark": "darkPrimary", "light": "lightPrimary" },
    "secondary": { "dark": "darkSecondary", "light": "lightSecondary" },
    "accent": { "dark": "darkAccent", "light": "lightAccent" },
    "error": { "dark": "darkError", "light": "lightError" },
    "warning": { "dark": "darkWarning", "light": "lightWarning" },
    "success": { "dark": "darkSuccess", "light": "lightSuccess" },
    "info": { "dark": "darkInfo", "light": "lightInfo" },
    "text": { "dark": "darkText", "light": "lightText" },
    "textMuted": { "dark": "darkMuted", "light": "lightMuted" },
    "selectedListItemText": { "dark": "darkBackground", "light": "#FFFFFF" },
    "background": { "dark": "darkBackground", "light": "lightBackground" },
    "backgroundPanel": { "dark": "darkPanel", "light": "lightPanel" },
    "backgroundElement": { "dark": "darkElement", "light": "lightElement" },
    "backgroundMenu": { "dark": "darkElement", "light": "lightElement" },
    "border": { "dark": "darkBorder", "light": "lightBorder" },
    "borderActive": { "dark": "darkBorderActive", "light": "lightBorderActive" },
    "borderSubtle": { "dark": "darkBorderSubtle", "light": "lightBorderSubtle" },
    "diffAdded": { "dark": "#72C29A", "light": "#347A60" },
    "diffRemoved": { "dark": "#F17A86", "light": "#B64D5D" },
    "diffContext": { "dark": "#7891A5", "light": "#7D91A4" },
    "diffHunkHeader": { "dark": "#70B8EA", "light": "#397FBC" },
    "diffHighlightAdded": { "dark": "#91D7B1", "light": "#2D7258" },
    "diffHighlightRemoved": { "dark": "#F49AA3", "light": "#A94251" },
    "diffAddedBg": { "dark": "#17372E", "light": "#E5F5ED" },
    "diffRemovedBg": { "dark": "#3B242B", "light": "#FBEAEC" },
    "diffContextBg": { "dark": "darkPanel", "light": "lightPanel" },
    "diffLineNumber": { "dark": "darkMuted", "light": "lightMuted" },
    "diffAddedLineNumberBg": { "dark": "#20483B", "light": "#D7EDDF" },
    "diffRemovedLineNumberBg": { "dark": "#4B2B33", "light": "#F3DDE1" },
    "markdownText": { "dark": "darkText", "light": "lightText" },
    "markdownHeading": { "dark": "darkPrimary", "light": "lightInfo" },
    "markdownLink": { "dark": "darkPrimary", "light": "lightPrimary" },
    "markdownLinkText": { "dark": "darkAccent", "light": "lightAccent" },
    "markdownCode": { "dark": "darkSuccess", "light": "#347A60" },
    "markdownBlockQuote": { "dark": "darkMuted", "light": "lightMuted" },
    "markdownEmph": { "dark": "darkWarning", "light": "#846421" },
    "markdownStrong": { "dark": "darkSecondary", "light": "#B64D5D" },
    "markdownHorizontalRule": { "dark": "darkBorder", "light": "lightBorder" },
    "markdownListItem": { "dark": "darkPrimary", "light": "lightPrimary" },
    "markdownListEnumeration": { "dark": "darkAccent", "light": "lightAccent" },
    "markdownImage": { "dark": "darkPrimary", "light": "lightPrimary" },
    "markdownImageText": { "dark": "darkAccent", "light": "lightAccent" },
    "markdownCodeBlock": { "dark": "darkText", "light": "lightText" },
    "syntaxComment": { "dark": "#7891A5", "light": "#7D91A4" },
    "syntaxKeyword": { "dark": "darkAccent", "light": "#2F7899" },
    "syntaxFunction": { "dark": "darkPrimary", "light": "lightPrimary" },
    "syntaxVariable": { "dark": "darkSecondary", "light": "#B64D5D" },
    "syntaxString": { "dark": "darkSuccess", "light": "#347A60" },
    "syntaxNumber": { "dark": "darkWarning", "light": "#846421" },
    "syntaxType": { "dark": "#E1C77C", "light": "#846421" },
    "syntaxOperator": { "dark": "darkMuted", "light": "#557083" },
    "syntaxPunctuation": { "dark": "darkText", "light": "lightText" }
  }
}
