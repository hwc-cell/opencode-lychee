{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "darkBackground": "#0C1B20",
    "darkPanel": "#12272D",
    "darkElement": "#19343C",
    "darkBorderSubtle": "#23434B",
    "darkBorder": "#315A64",
    "darkBorderActive": "#5B96A3",
    "darkText": "#DEF4F7",
    "darkMuted": "#8FB0B8",
    "darkPrimary": "#58BED1",
    "darkSecondary": "#FF6B76",
    "darkAccent": "#FF6B76",
    "darkError": "#FF6571",
    "darkWarning": "#E7B45D",
    "darkSuccess": "#67C28B",
    "darkInfo": "#61C2D4",
    "lightBackground": "#F3FBFF",
    "lightPanel": "#E9F7FB",
    "lightElement": "#DFF3F8",
    "lightBorderSubtle": "#CDE9EF",
    "lightBorder": "#B2DDE5",
    "lightBorderActive": "#72BBC9",
    "lightText": "#123845",
    "lightMuted": "#567681",
    "lightPrimary": "#197A95",
    "lightSecondary": "#C83D4B",
    "lightAccent": "#C83D4B",
    "lightError": "#C83D4B",
    "lightWarning": "#8E641E",
    "lightSuccess": "#2F7E57",
    "lightInfo": "#207E96"
  },
  "theme": {
    "primary": { "dark": "darkPrimary", "light": "lightPrimary" },
    "secondary": { "dark": "darkSecondary", "light": "lightSecondary" },
    "accent": { "dark": "darkAccent", "light": "lightAccent" },
    "error": { "dark": "darkError", "light": "lightError" },
    "warning": { "dark": "darkWarning", "light": "lightWarning" },
    "success": { "dark": "darkSuccess", "light": "lightSuccess" },
    "info": { "dark": "darkInfo", "light": "lightInfo" },
    "text": { "dark": "darkText", "light": "lightText" },
    "textMuted": { "dark": "darkMuted", "light": "lightMuted" },
    "selectedListItemText": { "dark": "darkBackground", "light": "#FFFFFF" },
    "background": { "dark": "darkBackground", "light": "lightBackground" },
    "backgroundPanel": { "dark": "darkPanel", "light": "lightPanel" },
    "backgroundElement": { "dark": "darkElement", "light": "lightElement" },
    "backgroundMenu": { "dark": "darkElement", "light": "lightElement" },
    "border": { "dark": "darkBorder", "light": "lightBorder" },
    "borderActive": { "dark": "darkBorderActive", "light": "lightBorderActive" },
    "borderSubtle": { "dark": "darkBorderSubtle", "light": "lightBorderSubtle" },
    "diffAdded": { "dark": "#67C28B", "light": "#2F7E57" },
    "diffRemoved": { "dark": "#FF6571", "light": "#C94653" },
    "diffContext": { "dark": "#789AA3", "light": "#6C8B94" },
    "diffHunkHeader": { "dark": "darkInfo", "light": "lightInfo" },
    "diffHighlightAdded": { "dark": "#8AD5A6", "light": "#27734D" },
    "diffHighlightRemoved": { "dark": "#FF9099", "light": "#B83B48" },
    "diffAddedBg": { "dark": "#15372B", "light": "#DDF4E8" },
    "diffRemovedBg": { "dark": "#412329", "light": "#FFE3E6" },
    "diffContextBg": { "dark": "darkPanel", "light": "lightPanel" },
    "diffLineNumber": { "dark": "darkMuted", "light": "lightMuted" },
    "diffAddedLineNumberBg": { "dark": "#1D4938", "light": "#CEECDB" },
    "diffRemovedLineNumberBg": { "dark": "#542A32", "light": "#F8D5D9" },
    "markdownText": { "dark": "darkText", "light": "lightText" },
    "markdownHeading": { "dark": "darkAccent", "light": "lightAccent" },
    "markdownLink": { "dark": "darkPrimary", "light": "lightPrimary" },
    "markdownLinkText": { "dark": "#83D8E5", "light": "#207E96" },
    "markdownCode": { "dark": "darkSuccess", "light": "#2F7E57" },
    "markdownBlockQuote": { "dark": "darkMuted", "light": "lightMuted" },
    "markdownEmph": { "dark": "darkWarning", "light": "#8E641E" },
    "markdownStrong": { "dark": "darkSecondary", "light": "lightSecondary" },
    "markdownHorizontalRule": { "dark": "darkBorder", "light": "lightBorder" },
    "markdownListItem": { "dark": "darkPrimary", "light": "lightPrimary" },
    "markdownListEnumeration": { "dark": "darkSecondary", "light": "lightSecondary" },
    "markdownImage": { "dark": "darkPrimary", "light": "lightPrimary" },
    "markdownImageText": { "dark": "#83D8E5", "light": "#207E96" },
    "markdownCodeBlock": { "dark": "darkText", "light": "lightText" },
    "syntaxComment": { "dark": "#789AA3", "light": "#6C8B94" },
    "syntaxKeyword": { "dark": "#FF7A84", "light": "#C94653" },
    "syntaxFunction": { "dark": "darkPrimary", "light": "lightPrimary" },
    "syntaxVariable": { "dark": "darkSecondary", "light": "lightError" },
    "syntaxString": { "dark": "darkSuccess", "light": "#2F7E57" },
    "syntaxNumber": { "dark": "darkWarning", "light": "#8E641E" },
    "syntaxType": { "dark": "#E7C36F", "light": "#8E641E" },
    "syntaxOperator": { "dark": "darkMuted", "light": "#4E7480" },
    "syntaxPunctuation": { "dark": "darkText", "light": "lightText" }
  }
}
